# --- Required always ---
BOT_TOKEN=
OWNER_IDS=1540617514

# --- Only needed for webhook mode (wsgi.py / Render), not for main.py polling ---
WEBHOOK_SECRET=

# --- Optional ---
# Leave empty on Render (server is outside Russia, no proxy needed) and on
# PythonAnywhere (its free-tier http_proxy/https_proxy env vars are picked up
# automatically). Only set this explicitly for Russian VPS hosts where
# Telegram is blocked (e.g. RuVDS + Xray/VLESS).
PROXY_URL=

# External Postgres connection string (Neon/Supabase/Render Postgres).
# Leave empty to fall back to local SQLite at data/wwgang.sqlite3 (not persistent on Render).
DATABASE_URL=

# --- Web admin panel (admin_web/) — separate from the bot process ---
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_PANEL_PORT=8811
