# Only needed for Russian VPS hosts where Telegram is blocked (e.g. RuVDS + Xray/VLESS).
PROXY_URL=

# External Postgres connection string (Neon/Supabase/Render Postgres).
# Leave empty to fall back to local SQLite at data/wwgang.sqlite3 (not persistent on Render).
DATABASE_URL=
